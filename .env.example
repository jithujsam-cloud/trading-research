# Copy to .env (git-ignored) or set in your shell. Never paste these into chat, code, or screenshots.
# Use ONE of the two login methods.

# Method 1: TOTP key (does not expire until you revoke it; keep it secret)
GROWW_API_KEY=
GROWW_TOTP_SECRET=

# Method 2: API key + secret (needs daily approval in Groww Cloud)
# GROWW_API_KEY=
# GROWW_API_SECRET=

# Web app (Vercel). Set these in Vercel's environment settings, not in code.
APP_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
