{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src,config}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "45 10 * * 1-5"
    }
  ]
}
